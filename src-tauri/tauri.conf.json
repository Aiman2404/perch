{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Perch",
  "version": "0.2.2",
  "identifier": "com.aiman2404.perch",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Perch",
        "width": 460,
        "height": 190,
        "x": 0,
        "y": 0,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "focus": false,
        "focusable": false,
        "visible": false,
        "dragDropEnabled": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,Translate,OptimizationHints,MediaRouter,AutofillServerCommunication,SpareRendererForSitePerProcess,CalculateNativeWinOcclusion --enable-features=NetworkServiceInProcess2 --disable-gpu --disable-gpu-compositing --in-process-gpu --renderer-process-limit=1 --disable-extensions --disable-background-networking --disable-component-update --disable-sync --no-first-run --disable-breakpad --num-raster-threads=1 --disk-cache-size=1 --js-flags=--jitless --max-lazy --max-old-space-size=16 --max-semi-space-size=1"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "idlebench",
    "copyright": "© 2026 Aiman2404. MIT License.",
    "category": "Utility",
    "shortDescription": "A tiny media island under your webcam",
    "longDescription": "Perch sits under your laptop's webcam and drops down when you need it: what's playing, volume, brightness, quick apps, a file shelf and clipboard history.",
    "homepage": "https://github.com/idlebench/perch",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "displayLanguageSelector": false
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFGMzgyNzNGRDE1QTlGNjgKUldSb24xclJQeWM0SHg0d1h0NCtKakdMaDcyc3B3Qi9OdjlOdVMrcUZRblQ1dXFWMTU4eGZaUHgK",
      "endpoints": [
        "https://github.com/idlebench/perch/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}